{
  "name": "projektor",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/system run dev",
    "build": "npm --prefix apps/system run build",
    "type-check": "npm --prefix apps/system run typecheck",
    "deploy": "node scripts/require-deployment-review.mjs",
    "lint": "npm --prefix apps/system run lint",
    "lint:fix": "npm --prefix apps/system run lint:fix",
    "format": "npm --prefix apps/system run lint:fix",
    "gen:docs": "npm --prefix apps/system run docs:generate",
    "bundle-budget": "tsx scripts/bundle-budget.ts",
    "bundle-budget:update": "tsx scripts/bundle-budget.ts --update",
    "prepare": "lefthook install",
    "legacy:dev": "turbo dev",
    "legacy:build": "turbo build",
    "legacy:type-check": "turbo type-check",
    "legacy:deploy": "turbo deploy",
    "legacy:lint": "biome check .",
    "legacy:lint:fix": "biome check --write .",
    "legacy:format": "biome format --write .",
    "legacy:gen:docs": "pnpm --filter @projektor/api gen:catalog && pnpm --filter @projektor/api gen:workflow-spec && pnpm --filter @projektor/api gen:playbooks && tsx scripts/gen-conventions-page.ts && tsx scripts/gen-feedback-example-page.ts",
    "setup": "npm --prefix apps/system ci --include=dev --include=optional",
    "start": "npm --prefix apps/system run dev",
    "test": "npm --prefix apps/system run test:ci",
    "verify": "npm --prefix apps/system run verify:ci",
    "release:build": "bash scripts/build-release.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@biomejs/cli-win32-x64": "2.5.8",
    "@cloudflare/workers-types": "^5.20260813.1",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.12",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "engines": {
    "node": "24.19.0",
    "pnpm": ">=9"
  }
}
