{
  "name": "projektor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:contracts": "node tools/check-boundaries.mjs --rule public-type",
    "test:boundary-checkers": "node --test tools/boundaries.test.mjs",
    "test:modules": "node tools/test.mjs",
    "test:migrations": "node tools/check-boundaries.mjs --rule schema",
    "build": "node tools/build.mjs",
    "check:artifact": "node tools/artifact.mjs",
    "generate": "node tools/generate.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test:boundary-checkers && pnpm test:modules && pnpm test:migrations && pnpm build && pnpm check:artifact && pnpm test:gateway",
    "smoke:cloudflare": "node tools/cloudflare-smoke.mjs",
    "test:smoke": "node tools/smoke-check.mjs local",
    "deploy:artifact": "node tools/disabled.mjs",
    "test:gateway": "node --test --test-concurrency=1 --test-reporter=dot tools/gateway.test.mjs tools/gateway-oauth.test.mjs tools/gateway-oauth-rules.test.mjs"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261013.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "wrangler": "4.150.0"
  }
}
