{
  "name": "projektor", "private": true, "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": { "node": ">=22.22.1" },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:contracts": "node tools/check-boundaries.mjs --rule public-type",
    "test:boundary-checkers": "node --test tools/boundaries.test.mjs",
    "test:modules": "node tools/test.mjs",
    "test:migrations": "node tools/check-boundaries.mjs --rule schema",
    "build": "node tools/build.mjs",
    "check:artifact": "node tools/artifact.mjs",
    "generate": "node tools/generate.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test:boundary-checkers && pnpm test:modules && pnpm test:migrations && pnpm build && pnpm check:artifact",
    "smoke:cloudflare": "node tools/disabled.mjs",
    "deploy:artifact": "node tools/disabled.mjs"
  },
  "dependencies": { "hono": "4.13.13" },
  "devDependencies": {
    "@biomejs/biome": "2.5.15", "@cloudflare/workers-types": "5.20261013.1",
    "esbuild": "0.28.2", "miniflare": "4.20260730.0", "typescript": "5.9.3"
  }
}
