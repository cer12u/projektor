{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!platform/generated",
      "!!apps/web",
      "!!pnpm-lock.yaml",
      "!!docs",
      "!!.tmp",
      "!!dist",
      "!!node_modules",
      "!!reports",
      "!!coverage",
      "!!test-results",
      "!!playwright-report",
      "!!.pnpm-store"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
