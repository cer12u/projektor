    "test:e2e":"node --test --test-timeout=90000 --test-reporter=./e2e/github-reporter.mjs e2e/*.test.mjs",
    "verify":"npm run build && npm test"
  },
  "dependencies":{"react":"19.3.0","react-dom":"19.3.0"},
  "devDependencies":{"@types/react":"19.3.0","@types/react-dom":"19.3.0","typescript":"5.9.3","vite":"8.3.3","playwright":"1.62.1"}
}
