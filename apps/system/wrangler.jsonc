{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "projektor-p1a-local",
  "main": "src/apps/worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/.well-known/*"]
  },
  "vars": { "AUTH_ORIGIN": "https://localhost:8787", "MCP_ENABLED": "false", "MCP_ACCESS_ISSUER": "", "MCP_ACCESS_AUDIENCE": "", "MCP_RESOURCE_METADATA_URL": "" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "projektor-p1a-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "./migrations",
    "remote": false
  }],
  "dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "https" }
}
