{
  "name": "projektor",
  "main": "apps/worker/index.ts",
  "compatibility_date": "2026-07-30",
  "d1_databases": [
    { "binding": "DB", "database_name": "projektor", "database_id": "REPLACE_WITH_APPROVED_D1_ID" }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_APPROVED_KV_ID" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "REPLACE_WITH_APPROVED_R2_BUCKET" }],
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp/*",
      "/.well-known/*",
      "/oauth/*",
      "/integrations/*",
      "/health"
    ]
  },
  "triggers": { "crons": ["0 * * * *"] },
  "ratelimits": [
    {
      "name": "OAUTH_REGISTER_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "OAUTH_TOKEN_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "secrets": { "required": ["INTEGRATIONS_KEY"] },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_ACCESS_TEAM_DOMAIN",
    "ACCESS_AUDIENCE": "REPLACE_WITH_ACCESS_AUDIENCE"
  }
}
